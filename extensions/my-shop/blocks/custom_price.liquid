<a 
href="{{block.settings.url}}"
class="btn {{block.settings.class}}"
style=" 
  color: {{block.settings.text_color}};
  background_color: {{block.settings.background_color}};
  padding: {{block.settings.padding}};
  margin: {{block.settings.margin}};
"

{% if block.settings.open_new_tab %} target = "_blank"{% endif %}>

{{block.settings.heading}}</a>


{% schema %}
{
  "name": "Custom Pricing Button",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Button Label", "default": "Request A Custom Price" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#000000" },
    { "type": "text", "id": "url", "label": "URL", "default": "mailto:contact@example.com" },
    { "type": "checkbox", "id": "open_new_tab", "label": "Open URL in a new tab", "default": true },
    { "type": "text", "id": "class", "label": "Class", "default": "button" },
    { "type": "text", "id": "padding", "label": "Padding", "default": "10px 5px" },
    { "type": "text", "id": "margin", "label": "Margin", "default": "10px 10px" },
  ]
}
{% endschema %}


