<div
  id="product-container"
  data-api-key="{{ block.settings.api_key }}"
  style="margin-top: 10px; display: flex; flex-direction: column; gap: 20px;"
></div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.getElementById('product-container');
    const apiKey = container.dataset.apiKey;

    let currencySign = window.dynamaticActiveCurrency;

    fetch(
      `https://navidium-static-assets.s3.us-east-1.amazonaws.com/dynamatics-assets/cdn/hefajt.myshopify.com/${apiKey}.json`
    )
      .then((response) => response.json())
      .then((data) => {
        try {
          const audience = data?.audiences?.[0];
          const experience = audience?.experiences?.[0];
          const variation = experience?.variations?.[0];
          const widget = variation?.widgets?.[0];
          const campaignId = experience?.campaign_id;
          const zoneId = experience?.zone_id;

          const products =
            data?.audiences?.[0]?.experiences?.[0]?.variations?.[0]?.widgets?.[0]?.property?.cart?.content
              ?.productSection?.selectedProducts;

          const general =
            data?.audiences?.[0]?.experiences?.[0]?.variations?.[0]?.widgets?.[0]?.property?.cart?.content?.general;

          const generalStyle =
            data?.audiences?.[0]?.experiences?.[0]?.variations?.[0]?.widgets?.[0]?.property?.cart?.style?.general;

          const mapBorderRadius = (radius) => {
            switch (radius?.toLowerCase()) {
              case 'sm':
                return '4px';
              case 'md':
                return '6px';
              case 'lg':
                return '8px';
              case 'xl':
                return '12px';
              case 'full':
                return '9999px';
              default:
                return radius || '4px';
            }
          };

          const hoverBG = generalStyle?.hover_buttonBGColor;
          const hoverText = generalStyle?.hover_buttonTextColor;

          const styleTag = document.createElement('style');
          styleTag.innerHTML = `
                .add-to-cart-btn:hover {
                  background-color: ${hoverBG} !important;
                  color: ${hoverText} !important;
                }
              `;
          document.head.appendChild(styleTag);


          let html = `
            <div style="text-align: ${generalStyle?.textAlignment};">
               <p style="
                padding-left: ${generalStyle?.titlePadding?.left};
                padding-right: ${generalStyle?.titlePadding?.right};
                padding-top: ${generalStyle?.titlePadding?.top};
                padding-bottom: ${generalStyle?.titlePadding?.bottom};
                font-size: ${generalStyle?.titleFontSize};
                font-weight: ${generalStyle?.titleFontWeight};
                color: ${generalStyle?.titleColor};
                background-color: ${generalStyle?.titleBgColor}; 
                font-family: ${generalStyle?.titleFontFamily};
              ">
                ${general?.title}
              </p>
              <p style="
                font-size: ${generalStyle?.subTitleFontSize};
                font-weight: ${generalStyle?.subTitleFontWeight};
                color: ${generalStyle?.subTitleColor};
                font-family: ${generalStyle?.subTitleFontFamily};

              ">
                ${general?.subTitle}
              </p>
            </div>
            `;

          products?.forEach((product, index) => {
            const variant = product?.product_variants?.[0];
            html += `
              <div style="display: flex; align-items: center; gap: 10px; margin: 10px;">
                <img src="${product?.product_image}" style="border-radius: 10px;" width="140px" height="140px" />
                <div>

                  <p style="
                    font-size: ${generalStyle?.productTitleFontSize};
                    font-weight: ${generalStyle?.productTitleFontWeight};
                    color: ${generalStyle?.productTitleColor};
                    font-family: ${generalStyle?.productTitleFontFamily};">
                    ${product?.product_title}
                  </p>

                  <p style="font-size: ${generalStyle?.productPriceFontSize};
                    font-weight: ${generalStyle?.productPriceFontWeight};
                    color: ${generalStyle?.productPriceColor};
                    font-family: ${generalStyle?.productPriceFontFamily};">
                    ${currencySign.symbol}${variant?.variant_price}
                  </p>


                  <div style=" font-size: 18px; color:${generalStyle?.ratingColor};">
                    ${'★'.repeat(general?.ratings || 0)}${'★'.repeat(5 - (general?.ratings || 0))}
                  </div>


                  <div style="width: 465px;">
                    <button style="
                      padding: 8px 16px;
                      height: 40px;
                      width: 100%; 
                      background-color: ${generalStyle?.buttonBGColor};
                      color: ${generalStyle?.buttonTextColor};
                      font-size: ${generalStyle?.buttonFontSize};
                      font-family: ${generalStyle?.buttonFontFamily};
                      font-weight: ${generalStyle?.buttonFontWeight};
                      border-radius: ${mapBorderRadius(generalStyle?.buttonBorderRadius)};
                      border: none;
                      cursor: pointer;"
                      class="add-to-cart-btn"
                      data-variant-id="${variant?.variant_id}"
                      data-experience-id="${experience?.id}"
                      data-variation-id="${variation?.id}"
                      data-audience-id="${audience?.id}"
                      data-widget-id="${widget?.id}"
                      data-campaign-id="${campaignId}"
                      data-zone-id="${zoneId}"
                    >
                      ${general?.buttonText}
                    </button>
                  </div>


                  


                  
                </div>
              </div>
              
              <hr style="height: 1px; border: none; background-color: #ccc;">

            `;
          });

          document.getElementById('product-container').innerHTML = html;
        } catch (err) {
          console.error('Error parsing product data:', err);
          document.getElementById('product-container').innerHTML = '<p>Failed to load product data.</p>';
        }
      })
      .catch((err) => {
        console.error('Fetch error:', err);
        document.getElementById('product-container').innerHTML = '<p>Failed to load product data.</p>';
      });

    container.addEventListener('click', function (event) {
      if (event.target.classList.contains('add-to-cart-btn')) {
        const variantId = event.target.dataset.variantId;
        const experienceId = event.target.dataset.experienceId;
        const audienceId = event.target.dataset.audienceId;
        const widgetId = event.target.dataset.widgetId;
        const campaignId = event.target.dataset.campaignId;
        const zoneId = event.target.dataset.zoneId;

        const formData = {
          items: [
            {
              id: parseInt(variantId),
              quantity: 1,
              properties: {
                experienceId: parseInt(experienceId),
                variationId: parseInt(variantId),
                audienceId: parseInt(audienceId),
                widgetId: parseInt(widgetId),
                campaignId: parseInt(campaignId),
                zoneId: parseInt(zoneId),
              },
            },
          ],
        };

        fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(formData),
        })
          .then((response) => response.json())
          .then((data) => {
            console.log('Added to cart:', data);
            alert('Product added to cart!');
          })
          .catch((error) => {
            console.error('Add to cart error:', error);
          });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Product",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "api_key",
      "label": "Zone ID",
      "default": "ZID0873-HEF52121745906979-WEBPAGECATEGORY"
    }
  ]
}
{% endschema %}
